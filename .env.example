# OpenAI API — 없으면 MOCK 모드로 동작 (UI 개발 가능)
OPENAI_API_KEY=

# Supabase — 없으면 data/documents.jsonl 로컬 검색으로 폴백
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API 서버 포트 (기본 8787). 배포 시 호스트가 자동 주입한다.
# PORT=8787

# 비용 가드 (공개 배포 시) — 미설정이면 IP당 시간 20회 / 전체 하루 300회
# RATE_LIMIT_PER_IP=20
# RATE_LIMIT_DAILY=300
