{
  "name": "soboru",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "tsx --test tests/*.test.ts",
    "eval": "npm run eval:repair && npm run eval:caverify",
    "eval:repair": "tsx --env-file-if-exists=.env scripts/test_repair.ts",
    "eval:caverify": "tsx --env-file-if-exists=.env scripts/test_caverify.ts",
    "eval:pipeline": "tsx --env-file-if-exists=.env scripts/test_pipeline.ts",
    "eval:perturb": "tsx --env-file-if-exists=.env scripts/ca_perturb.ts",
    "demo": "tsx scripts/make_demo.ts",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "openai": "^6.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
